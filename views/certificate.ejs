<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Certificate | TrustLedger</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
rel="stylesheet">

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
rel="stylesheet">

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: #f5f5f8;
    color: #333;
}

.certificate-page {
    min-height: 100vh;
    padding: 40px 20px;
}

/* ==================================================
   COMMON CERTIFICATE
================================================== */

.certificate-card {
    max-width: 1000px;
    min-height: 700px;
    margin: auto;
    padding: 55px;
    position: relative;
    overflow: hidden;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,.15);
}

.certificate-card > * {
    position: relative;
    z-index: 2;
}

/* ==================================================
   TEMPLATE 1 - CLASSIC PROFESSIONAL
================================================== */

.template-classic {
    background: linear-gradient(135deg,#ffffff,#f7f7f7);
    border: 10px double #242424;
    color: #242424;
}

.template-classic .certificate-header i,
.template-classic .certificate-header h2,
.template-classic .certificate-title h1,
.template-classic .student-name,
.template-classic .qr-section h5 {
    color: #222222;
}

.template-classic .certificate-title::after {
    background: #222222;
}

.template-classic .details-box {
    border: 1px solid #aaaaaa;
    background: #fafafa;
}

.template-classic .detail-label {
    color: #444444;
}

.template-classic .print-btn {
    background: #222222;
}

/* ==================================================
   TEMPLATE 2 - MODERN PURPLE
================================================== */

.template-purple {
    background: linear-gradient(
        135deg,
        #fffaf0 0%,
        #fff0f5 45%,
        #eeeafb 100%
    );

    border: 4px solid #8d7bff;
}

.template-purple::before {
    content: "";
    position: absolute;

    width: 300px;
    height: 300px;

    top: -160px;
    left: -150px;

    border-radius: 50%;

    background: rgba(141,123,255,.25);
}

.template-purple::after {
    content: "";
    position: absolute;

    width: 330px;
    height: 330px;

    right: -160px;
    bottom: -170px;

    border-radius: 50%;

    background: rgba(255,182,193,.25);
}

.template-purple .certificate-header i,
.template-purple .certificate-header h2,
.template-purple .certificate-title h1,
.template-purple .student-name,
.template-purple .qr-section h5 {
    color: #4b2c88;
}

.template-purple .certificate-title::after {
    background: linear-gradient(90deg,#8d7bff,#c8a7ff);
}

.template-purple .details-box {
    background: rgba(255,255,255,.65);
    border: 1px solid #dcd3ff;
}

.template-purple .detail-label {
    color: #7c5ac2;
}

.template-purple .print-btn {
    background: linear-gradient(90deg,#8d7bff,#c8a7ff);
}

/* ==================================================
   TEMPLATE 3 - ELEGANT GOLD
================================================== */

.template-gold {
    background: linear-gradient(
        135deg,
        #fffdf5,
        #fff8df,
        #ffffff
    );

    border: 8px double #b68b2c;
}

.template-gold::before {
    content: "";
    position: absolute;

    inset: 20px;

    border: 2px solid #d5b45c;

    pointer-events: none;
}

.template-gold .certificate-header i,
.template-gold .certificate-header h2,
.template-gold .certificate-title h1,
.template-gold .student-name,
.template-gold .qr-section h5 {
    color: #8a651b;
}

.template-gold .certificate-title h1,
.template-gold .student-name {
    font-family: 'Playfair Display', serif;
}

.template-gold .certificate-title::after {
    background: linear-gradient(90deg,#8a651b,#e0c36c);
}

.template-gold .details-box {
    background: rgba(255,253,245,.88);
    border: 1px solid #d5b45c;
}

.template-gold .detail-label {
    color: #8a651b;
}

.template-gold .print-btn {
    background: linear-gradient(90deg,#9b7421,#d4ad4d);
}

/* ==================================================
   TEMPLATE 4 - CORPORATE BLUE
================================================== */

.template-blue {
    background: linear-gradient(
        135deg,
        #ffffff,
        #eef7ff
    );

    border: 5px solid #1769aa;
}

.template-blue::before {
    content: "";
    position: absolute;

    width: 420px;
    height: 420px;

    background: #1769aa;

    transform: rotate(45deg);

    right: -330px;
    top: -260px;
}

.template-blue .certificate-header i,
.template-blue .certificate-header h2,
.template-blue .certificate-title h1,
.template-blue .student-name,
.template-blue .qr-section h5 {
    color: #155b91;
}

.template-blue .certificate-title::after {
    background: #1769aa;
}

.template-blue .details-box {
    background: #f5faff;
    border: 1px solid #c9e4f8;
    border-left: 5px solid #1769aa;
}

.template-blue .detail-label {
    color: #1769aa;
}

.template-blue .print-btn {
    background: #1769aa;
}

/* ==================================================
   TEMPLATE 5 - MINIMAL GREEN
================================================== */

.template-green {
    background: linear-gradient(
        135deg,
        #ffffff,
        #f1fff8
    );

    border: 3px solid #529b72;
}

.template-green::before {
    content: "";
    position: absolute;

    width: 250px;
    height: 250px;

    border-radius: 50%;

    background: rgba(82,155,114,.12);

    top: -100px;
    right: -90px;
}

.template-green .certificate-header i,
.template-green .certificate-header h2,
.template-green .certificate-title h1,
.template-green .student-name,
.template-green .qr-section h5 {
    color: #397653;
}

.template-green .certificate-title::after {
    background: #529b72;
}

.template-green .details-box {
    background: #f7fffa;
    border: 1px solid #b9ddc7;
}

.template-green .detail-label {
    color: #397653;
}

.template-green .print-btn {
    background: #529b72;
}

/* ==================================================
   HEADER
================================================== */

.certificate-header {
    text-align: center;
}

.certificate-header i {
    font-size: 55px;
    display: block;
    margin-bottom: 10px;
}

.certificate-header h2 {
    font-size: 32px;
    font-weight: 700;
    margin: 0;
}

.certificate-header p {
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 6px;
    color: #777;
}

/* ==================================================
   TITLE
================================================== */

.certificate-title {
    text-align: center;
    margin: 35px 0 25px;
}

.certificate-title h1 {
    font-size: 42px;
    font-weight: 700;
    text-transform: capitalize;
}

.certificate-title::after {
    content: "";
    display: block;

    width: 120px;
    height: 4px;

    margin: 15px auto;

    border-radius: 10px;
}

/* ==================================================
   STUDENT
================================================== */

.certificate-text {
    text-align: center;
    color: #666;
    font-size: 15px;
}

.student-name {
    text-align: center;
    font-size: 38px;
    font-weight: 700;
    margin: 15px 0;
}

/* ==================================================
   DETAILS
================================================== */

.details-box {
    margin-top: 35px;
    padding: 28px;
    border-radius: 16px;
}

.detail-item {
    margin-bottom: 17px;
}

.detail-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .5px;
    margin-bottom: 3px;
}

/* ==================================================
   QR CODE
================================================== */

.qr-section {
    text-align: center;
    margin-top: 30px;
}

.qr-section h5 {
    font-weight: 600;
    margin-bottom: 15px;
}

.qr-section img {
    width: 145px;
    height: 145px;

    background: #ffffff;

    padding: 7px;

    border: 1px solid #dddddd;
    border-radius: 12px;
}

/* ==================================================
   VERIFIED
================================================== */

.verified {
    margin-top: 25px;
    text-align: center;
    font-size: 17px;
    font-weight: 600;
    color: #198754;
}

.verified i {
    margin-right: 5px;
}

/* ==================================================
   ACTION BUTTONS
================================================== */

.certificate-actions {
    text-align: center;
    margin-top: 30px;
}

.certificate-actions a,
.certificate-actions button {
    padding: 11px 25px;
    margin: 5px;
    border-radius: 30px;
}

.print-btn {
    border: none;
    color: #ffffff;
}

.print-btn:hover {
    color: #ffffff;
    opacity: .9;
}

/* ==================================================
   MOBILE
================================================== */

@media(max-width:768px) {

    .certificate-card {
        padding: 35px 20px;
    }

    .certificate-title h1 {
        font-size: 30px;
    }

    .student-name {
        font-size: 27px;
    }
}

/* ==================================================
   PRINT
================================================== */

@media print {

    body {
        background: #ffffff;
    }

    .certificate-page {
        padding: 0;
    }

    .certificate-card {
        box-shadow: none;
        max-width: 100%;
        border-radius: 0;
    }

    .certificate-actions {
        display: none;
    }
}

</style>

</head>

<body>

<%
/*
    Selected template comes from certificateController.js.

    Expected values:
    classic
    purple
    gold
    blue
    green

    Old certificates may not have template,
    therefore classic is used as fallback.
*/

const allowedTemplates = [
    "classic",
    "purple",
    "gold",
    "blue",
    "green"
];

let selectedTemplate = certificate.template || "classic";

if (!allowedTemplates.includes(selectedTemplate)) {
    selectedTemplate = "classic";
}

const templateClass = "template-" + selectedTemplate;
%>


<div class="certificate-page">

<div class="certificate-card <%= templateClass %>">


<!-- ================= HEADER ================= -->

<div class="certificate-header">

<i class="bi bi-shield-check"></i>

<h2>
TrustLedger
</h2>

<p>
DIGITALLY VERIFIED CERTIFICATE
</p>

</div>


<!-- ================= CERTIFICATE TITLE ================= -->

<div class="certificate-title">

<h1>
<%= certificate.certificateTitle %>
</h1>

</div>


<p class="certificate-text">
This certificate is proudly awarded to
</p>


<div class="student-name">
<%= certificate.studentName %>
</div>


<p class="certificate-text">

for successfully fulfilling the requirements
of the stated program/certificate.

</p>


<!-- ================= DETAILS ================= -->

<div class="details-box">

<div class="row">


<div class="col-md-6 detail-item">

<span class="detail-label">
CERTIFICATE ID
</span>

<%= certificate.certificateId %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
ROLL NUMBER
</span>

<%= certificate.rollNumber %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
COURSE
</span>

<%= certificate.course %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
DEPARTMENT
</span>

<%= certificate.department %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
RESULT / GRADE
</span>

<%= certificate.grade %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
ISSUE DATE
</span>

<%= certificate.issueDate %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
EMAIL
</span>

<%= certificate.email %>

</div>


<div class="col-md-6 detail-item">

<span class="detail-label">
STATUS
</span>

<span class="badge bg-success">

<i class="bi bi-patch-check-fill"></i>

Verified

</span>

</div>


</div>

</div>


<!-- ================= QR CODE ================= -->

<div class="qr-section">

<h5>

<i class="bi bi-qr-code"></i>

Certificate Verification

</h5>


<img
src="<%= certificate.qrCode %>"
alt="Certificate QR Code">


<p class="text-muted mt-3">
Scan QR code to verify authenticity
</p>

</div>


<!-- ================= VERIFIED ================= -->

<div class="verified">

<i class="bi bi-patch-check-fill"></i>

Verified & Secured by TrustLedger

</div>


<!-- ================= BUTTONS ================= -->

<div class="certificate-actions">

<button
type="button"
onclick="window.history.back()"
class="btn btn-outline-secondary">

<i class="bi bi-arrow-left"></i>

Go Back

</button>


<button
type="button"
onclick="window.print()"
class="btn print-btn">

<i class="bi bi-printer"></i>

Print Certificate

</button>

</div>


</div>

</div>

</body>

</html>