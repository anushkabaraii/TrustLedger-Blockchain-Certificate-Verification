<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Certificate List | TrustLedger</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="dashboard-wrapper">

<!-- Sidebar -->

<div class="sidebar">

<div class="sidebar-logo">

<i class="bi bi-shield-check"></i>

<h3>TrustLedger</h3>

</div>

<ul>

<li>

<a href="/dashboard">

<i class="bi bi-speedometer2"></i>

Dashboard

</a>

</li>

<li>

<a href="/issue">

<i class="bi bi-award"></i>

Issue Certificate

</a>

</li>

<li class="active">

<a href="/certificates">

<i class="bi bi-folder2-open"></i>

Certificate List

</a>

</li>

<li>

<a href="/verify">

<i class="bi bi-search"></i>

Verify Certificate

</a>

</li>

<li>

<a href="/blockchain">

<i class="bi bi-link-45deg"></i>

Blockchain Records

</a>

</li>

<li>

<a href="/logout">

<i class="bi bi-box-arrow-right"></i>

Logout

</a>

</li>

</ul>

</div>

<!-- Main Content -->

<div class="dashboard-content">

<h2>Issued Certificates</h2>

<p>

View and manage all blockchain secured certificates.

</p>
<div class="certificate-form">

<div class="table-responsive">

<table class="table recent-table align-middle">

<thead>

<tr>

<th>Certificate ID</th>

<th>Student Name</th>

<th>Roll No.</th>

<th>Course</th>

<th>Issue Date</th>

<th>Status</th>

<th>Action</th>

</tr>

</thead>
<tbody>

<% if (certificates && certificates.length > 0) { %>

    <% certificates.slice().reverse().forEach(function(cert) { %>

    <tr>

        <td>
            <strong><%= cert.certificateId %></strong>
        </td>

        <td>
            <%= cert.studentName %>
        </td>

        <td>
            <%= cert.rollNumber %>
        </td>

        <td>
            <%= cert.course %>
        </td>

        <td>
            <%= cert.issueDate %>
        </td>

        <td>

            <span class="badge bg-success">

                <i class="bi bi-patch-check-fill"></i>
                <%= cert.status %>

            </span>

        </td>

        <td>

            <a
                href="/certificate?id=<%= cert.certificateId %>"
                class="btn btn-sm btn-admin">

                <i class="bi bi-eye-fill"></i>
                View

            </a>

        </td>

    </tr>

    <% }); %>

<% } else { %>

    <tr>

        <td colspan="7" class="text-center py-5">

            <div class="empty-state">

                <i class="bi bi-folder-x"></i>

                <h5>No Certificates Found</h5>

                <p>
                    No certificates have been issued yet.
                </p>

                <a href="/issue" class="btn-admin">

                    <i class="bi bi-plus-circle-fill"></i>

                    Issue First Certificate

                </a>

            </div>

        </td>

    </tr>

<% } %>

</tbody>




</table>

</div>

</div>
<div class="dashboard-footer">

<p>

Developed by

<strong>Anushka Barai</strong>

</p>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>