<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Blockchain Records | TrustLedger</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">

<style>

.blockchain-card{
    margin-top:35px;
    background:rgba(255,255,255,.60);
    backdrop-filter:blur(18px);
    padding:30px;
    border-radius:30px;
    box-shadow:0 15px 35px rgba(0,0,0,.08);
}

.blockchain-table{
    width:100%;
}

.blockchain-table th{
    color:#4b2c88;
    font-weight:600;
    padding:16px;
}

.blockchain-table td{
    padding:16px;
    vertical-align:middle;
}

.hash-text{
    max-width:250px;
    word-break:break-all;
    font-size:12px;
    color:#666;
}

.block-number{
    font-weight:700;
    color:#7C5AC2;
}

</style>

</head>

<body>

<div class="dashboard-wrapper">

<!-- SIDEBAR -->

<div class="sidebar">

<div class="sidebar-logo">

<i class="bi bi-shield-check"></i>
<h3>TrustLedger</h3>

</div>

<ul>

<li>
<a href="/dashboard">
<i class="bi bi-speedometer2"></i>
Dashboard
</a>
</li>

<li>
<a href="/issue">
<i class="bi bi-award"></i>
Issue Certificate
</a>
</li>

<li>
<a href="/certificates">
<i class="bi bi-folder2-open"></i>
Certificate List
</a>
</li>

<li>
<a href="/verify">
<i class="bi bi-search"></i>
Verify Certificate
</a>
</li>

<li class="active">
<a href="/blockchain">
<i class="bi bi-link-45deg"></i>
Blockchain Records
</a>
</li>

<li>
<a href="/logout">
<i class="bi bi-box-arrow-right"></i>
Logout
</a>
</li>

</ul>

</div>


<!-- MAIN CONTENT -->

<div class="dashboard-content">

<h2>Blockchain Records</h2>

<p>
View the immutable SHA-256 records of issued certificates.
</p>
<% if (chainValid) { %>

    <div class="alert alert-success mt-4">

        <i class="bi bi-shield-check"></i>

        <strong>Blockchain Integrity: Valid</strong>

        — All linked certificate records are secure and consistent.

    </div>

<% } else { %>

    <div class="alert alert-danger mt-4">

        <i class="bi bi-exclamation-triangle-fill"></i>

        <strong>Blockchain Chain Compromised!</strong>

        — A broken or modified hash link has been detected.

    </div>

<% } %>


<div class="blockchain-card">

<% if (certificates && certificates.length > 0) { %>

<div class="table-responsive">

<table class="table blockchain-table align-middle">

<thead>

<tr>

<th>Block</th>
<th>Certificate ID</th>
<th>Student</th>
<th>Previous Hash</th>
<th>SHA-256 Hash</th>
<th>Issue Date</th>
<th>Status</th>
<th>Action</th>

</tr>

</thead>


<tbody>

<% certificates.slice().reverse().forEach(function(cert, index) { %>

<tr>

<td>
<span class="block-number">
#<%= certificates.length - index %>
</span>
</td>


<td>

<strong>
<%= cert.certificateId %>
</strong>

</td>


<td>

<%= cert.studentName %>

</td>
<td>
    <div class="hash-text">

        <% if (cert.previousHash) { %>

            <%= cert.previousHash %>

        <% } else { %>

            <span class="text-muted">
                Legacy Record
            </span>

        <% } %>

    </div>
</td>

<td>

<div class="hash-text">

<%= cert.blockchainHash %>

</div>

</td>


<td>

<%= cert.issueDate %>

</td>


<td>

<span class="badge bg-success">

<i class="bi bi-shield-check"></i>

Valid

</span>

</td>


<td>

<a
href="/certificate?id=<%= cert.certificateId %>"
class="btn btn-sm btn-admin">

<i class="bi bi-eye"></i>

View

</a>

</td>

</tr>

<% }); %>

</tbody>

</table>

</div>


<% } else { %>


<div class="text-center py-5">

<i
class="bi bi-link-45deg"
style="font-size:55px;color:#8D7BFF;">
</i>

<h4 class="mt-3">
No Blockchain Records
</h4>

<p class="text-muted">

Issue a certificate to create the first blockchain record.

</p>

<a href="/issue" class="btn-admin">

<i class="bi bi-plus-circle"></i>

Issue Certificate

</a>

</div>


<% } %>

</div>


<div class="dashboard-footer">

<p>

Developed by
<strong>Anushka Barai</strong>

</p>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>