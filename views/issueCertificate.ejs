<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Issue Certificate | TrustLedger</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
rel="stylesheet">

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<link
rel="stylesheet"
href="/css/style.css">

<style>

/* =========================================
   TEMPLATE SELECTION
========================================= */

.template-selection {

    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 18px;

    margin-top: 10px;
}

.template-card {

    position: relative;

    cursor: pointer;

    text-align: center;

    transition: .25s ease;
}

.template-card input {

    position: absolute;

    opacity: 0;

    pointer-events: none;
}

.template-preview {

    height: 145px;

    border-radius: 16px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 10px;

    margin-bottom: 12px;

    border: 3px solid transparent;

    box-shadow:
        0 8px 25px rgba(0,0,0,.08);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border .25s ease;
}

.template-preview i {

    font-size: 34px;
}

.template-preview span {

    font-size: 13px;

    font-weight: 600;
}

.template-card h6 {

    font-size: 13px;

    font-weight: 600;

    margin: 0;
}

.template-card:hover .template-preview {

    transform: translateY(-5px);

    box-shadow:
        0 12px 30px rgba(0,0,0,.13);
}

/* =========================================
   CLASSIC
========================================= */

.classic-template {

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #f2f2f2
        );

    border: 4px double #333;

    color: #222;
}

/* =========================================
   PURPLE
========================================= */

.purple-template {

    background:
        linear-gradient(
            135deg,
            #fff0f5,
            #eeeafb
        );

    border: 2px solid #8d7bff;

    color: #4b2c88;
}

/* =========================================
   GOLD
========================================= */

.gold-template {

    background:
        linear-gradient(
            135deg,
            #fffdf5,
            #fff1bf
        );

    border: 4px double #b68b2c;

    color: #8a651b;
}

/* =========================================
   BLUE
========================================= */

.blue-template {

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #e4f3ff
        );

    border: 2px solid #1769aa;

    color: #1769aa;
}

/* =========================================
   GREEN
========================================= */

.green-template {

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #e8fff1
        );

    border: 2px solid #529b72;

    color: #397653;
}

/* =========================================
   SELECTED TEMPLATE
========================================= */

.template-card
input:checked
+
.template-preview {

    transform:
        translateY(-5px)
        scale(1.02);

    box-shadow:
        0 0 0 4px rgba(141,123,255,.18),
        0 15px 35px rgba(0,0,0,.15);
}

.template-card
input:checked
+
.classic-template {

    border-color: #111;
}

.template-card
input:checked
+
.purple-template {

    border: 4px solid #8d7bff;
}

.template-card
input:checked
+
.gold-template {

    border: 5px double #b68b2c;
}

.template-card
input:checked
+
.blue-template {

    border: 4px solid #1769aa;
}

.template-card
input:checked
+
.green-template {

    border: 4px solid #529b72;
}

/* =========================================
   MOBILE
========================================= */

@media(max-width:1200px) {

    .template-selection {

        grid-template-columns:
            repeat(3, 1fr);
    }
}

@media(max-width:768px) {

    .template-selection {

        grid-template-columns:
            repeat(2, 1fr);
    }
}

@media(max-width:480px) {

    .template-selection {

        grid-template-columns:
            1fr;
    }
}

</style>

</head>


<body>

<div class="dashboard-wrapper">


<!-- =========================================
     SIDEBAR
========================================= -->

<div class="sidebar">

<div class="sidebar-logo">

<i class="bi bi-shield-check"></i>

<h3>
TrustLedger
</h3>

</div>


<ul>


<li>

<a href="/dashboard">

<i class="bi bi-speedometer2"></i>

Dashboard

</a>

</li>


<li class="active">

<a href="/issue">

<i class="bi bi-award"></i>

Issue Certificate

</a>

</li>


<li>

<a href="/certificates">

<i class="bi bi-folder2-open"></i>

Certificate List

</a>

</li>


<li>

<a href="/verify">

<i class="bi bi-search"></i>

Verify Certificate

</a>

</li>


<li>

<a href="/blockchain">

<i class="bi bi-link-45deg"></i>

Blockchain Records

</a>

</li>


<li>

<a href="/logout">

<i class="bi bi-box-arrow-right"></i>

Logout

</a>

</li>


</ul>

</div>


<!-- =========================================
     MAIN CONTENT
========================================= -->

<div class="dashboard-content">


<h2>
Issue New Certificate
</h2>


<p>

Fill in the details below to generate a
blockchain-secured certificate.

</p>


<div class="certificate-form">


<form
action="/issue"
method="POST">


<div class="row">


<!-- =========================================
     STUDENT NAME
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Student Name

</label>


<input
type="text"
name="studentName"
class="form-control"
placeholder="Enter Student Name"
autocomplete="off"
required>

</div>


<!-- =========================================
     ROLL NUMBER
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Roll Number

</label>


<input
type="text"
name="rollNumber"
class="form-control"
placeholder="Enter Roll Number"
autocomplete="off"
required>

</div>


<!-- =========================================
     EMAIL
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Email Address

</label>


<input
type="email"
name="email"
class="form-control"
placeholder="Enter Email Address"
autocomplete="off"
required>

</div>


<!-- =========================================
     COURSE
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Course Name

</label>


<input
type="text"
name="course"
class="form-control"
placeholder="Enter Course Name"
autocomplete="off"
required>

</div>


<!-- =========================================
     DEPARTMENT
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Department

</label>


<input
type="text"
name="department"
class="form-control"
placeholder="Enter Department"
autocomplete="off"
required>

</div>


<!-- =========================================
     CERTIFICATE TITLE
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Certificate Title

</label>


<input
type="text"
name="certificateTitle"
class="form-control"
placeholder="Enter Certificate Title"
autocomplete="off"
required>

</div>


<!-- =========================================
     RESULT / GRADE
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Result / Grade

</label>


<select
name="grade"
class="form-select"
required>


<option
value=""
selected
disabled>

Select Result / Grade

</option>


<option value="A+">
A+
</option>


<option value="A">
A
</option>


<option value="B+">
B+
</option>


<option value="B">
B
</option>


<option value="C">
C
</option>


<option value="Pass">
Pass
</option>


<option value="Distinction">
Distinction
</option>


<option value="First Class">
First Class
</option>


<option value="Successfully Completed">
Successfully Completed
</option>


</select>

</div>


<!-- =========================================
     ISSUE DATE
========================================= -->

<div class="col-lg-6 mb-4">

<label class="form-label">

Issue Date

</label>


<input
type="date"
name="issueDate"
class="form-control"
required>

</div>


<!-- =========================================
     TEMPLATE SELECTION
========================================= -->

<div class="col-12 mt-3">


<label class="form-label">

Choose Certificate Template

</label>


<p class="text-muted mb-4">

Select the design you want to use for this
certificate.

</p>


<div class="template-selection">


<!-- =========================================
     TEMPLATE 1 - CLASSIC
========================================= -->

<label class="template-card">


<input
type="radio"
name="template"
value="classic"
required>


<div class="template-preview classic-template">


<i class="bi bi-award"></i>


<span>
Certificate
</span>


</div>


<h6>

Classic Professional

</h6>


</label>


<!-- =========================================
     TEMPLATE 2 - PURPLE
========================================= -->

<label class="template-card">


<input
type="radio"
name="template"
value="purple"
required>


<div class="template-preview purple-template">


<i class="bi bi-patch-check"></i>


<span>
Certificate
</span>


</div>


<h6>

Modern Purple

</h6>


</label>


<!-- =========================================
     TEMPLATE 3 - GOLD
========================================= -->

<label class="template-card">


<input
type="radio"
name="template"
value="gold"
required>


<div class="template-preview gold-template">


<i class="bi bi-trophy"></i>


<span>
Certificate
</span>


</div>


<h6>

Elegant Gold

</h6>


</label>


<!-- =========================================
     TEMPLATE 4 - BLUE
========================================= -->

<label class="template-card">


<input
type="radio"
name="template"
value="blue"
required>


<div class="template-preview blue-template">


<i class="bi bi-mortarboard"></i>


<span>
Certificate
</span>


</div>


<h6>

Corporate Blue

</h6>


</label>


<!-- =========================================
     TEMPLATE 5 - GREEN
========================================= -->

<label class="template-card">


<input
type="radio"
name="template"
value="green"
required>


<div class="template-preview green-template">


<i class="bi bi-shield-check"></i>


<span>
Certificate
</span>


</div>


<h6>

Minimal Green

</h6>


</label>


</div>

</div>


<!-- =========================================
     TEMPLATE SELECTION END
========================================= -->


</div>


<!-- =========================================
     GENERATE BUTTON
========================================= -->

<div class="text-center mt-5">


<button
type="submit"
class="btn generate-btn">


<i class="bi bi-patch-check-fill"></i>


Generate Certificate


</button>


</div>


</form>


</div>


<!-- =========================================
     FOOTER
========================================= -->

<div class="dashboard-footer">


<p>

Developed by

<strong>
Anushka Barai
</strong>

</p>


</div>


</div>

</div>


<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>

</html>